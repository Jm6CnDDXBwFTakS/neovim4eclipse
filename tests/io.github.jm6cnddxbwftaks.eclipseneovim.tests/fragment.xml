<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!-- Contributions used only by the UI tests. They are inert until a test activates the context below. -->
<fragment>

   <!-- Some installed plug-ins bind F3 for every text editor to a command that only their own editors
        handle. A test activates this context to recreate that in the plain Text Editor. -->
   <extension point="org.eclipse.ui.contexts">
      <context
            id="io.github.jm6cnddxbwftaks.eclipseneovim.tests.context.unhandledF3"
            name="Neovim for Eclipse tests: F3 without a handler"
            parentId="org.eclipse.ui.textEditorScope">
      </context>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <command
            id="io.github.jm6cnddxbwftaks.eclipseneovim.tests.commands.unhandledF3"
            name="Neovim for Eclipse tests: F3 without a handler">
      </command>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.tests.commands.unhandledF3"
            contextId="io.github.jm6cnddxbwftaks.eclipseneovim.tests.context.unhandledF3"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="F3">
      </key>
   </extension>

   <!-- A stand-in for a Language Server's go-to-definition in the Generic Editor: the word LINKME is a
        link. Only test files contain that word. -->
   <extension point="org.eclipse.ui.workbench.texteditor.hyperlinkDetectors">
      <hyperlinkDetector
            id="io.github.jm6cnddxbwftaks.eclipseneovim.tests.hyperlinkDetector"
            name="Neovim for Eclipse tests: LINKME"
            class="io.github.jm6cnddxbwftaks.eclipseneovim.editor.TestHyperlinkDetector"
            targetId="org.eclipse.ui.genericeditor.GenericEditor">
      </hyperlinkDetector>
   </extension>

   <!-- A stand-in for a multi-page editor such as the POM editor (a text page and a page without
        text), for the tab commands in such an editor. Only test files have the extension mpage. -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="io.github.jm6cnddxbwftaks.eclipseneovim.tests.multiPageEditor"
            name="Neovim for Eclipse tests: multi-page editor"
            class="io.github.jm6cnddxbwftaks.eclipseneovim.editor.TestMultiPageEditor"
            extensions="mpage"
            default="true">
      </editor>
   </extension>

</fragment>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Plain jar module, part of the root reactor; also runs alone:
       mvn test -f tests/unit/pom.xml
       Library versions come from the root pom.xml (dependencyManagement). -->
  <parent>
    <groupId>io.github.jm6cnddxbwftaks.neovim4eclipse</groupId>
    <artifactId>neovim4eclipse</artifactId>
    <version>0.1.9-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>neovim4eclipse-unit-tests</artifactId>
  <packaging>jar</packaging>

  <name>Neovim for Eclipse Unit Tests</name>
  <description>
    Platform-neutral unit tests for util/ and core/ (no SWT, no Eclipse runtime).
    Sources under test come from the plug-in project; there is no second copy.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Same Java release as the plug-in (root pom.xml). -->
    <maven.compiler.release>${java.release}</maven.compiler.release>
    <!-- Coverage data and report; the integration profile writes its own pair, so a run with real
         Neovim does not overwrite the unit-test numbers. -->
    <jacoco.dataFile>${project.build.directory}/jacoco.exec</jacoco.dataFile>
    <jacoco.reportDir>${project.build.directory}/site/jacoco</jacoco.reportDir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.msgpack</groupId>
      <artifactId>msgpack-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <!-- Test helpers shared by the test modules (ExpectedLog), kept once in the UI test
               fragment's shared/ folder (see its build.properties). -->
          <execution>
            <id>add-shared-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../io.github.jm6cnddxbwftaks.neovim4eclipse.tests/shared</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-plugin-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../plugins/io.github.jm6cnddxbwftaks.neovim4eclipse/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>io/github/jm6cnddxbwftaks/neovim4eclipse/util/**</include>
            <include>io/github/jm6cnddxbwftaks/neovim4eclipse/core/**</include>
          </includes>
        </configuration>
      </plugin>
      <!-- Code coverage: the JaCoCo agent records which lines the tests run; the report is
           target/site/jacoco/index.html (see CONTRIBUTING.md, "Code coverage"). prepare-agent sets
           the "argLine" property, which surefire passes to the forked test JVM. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dataFile}</destFile>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${jacoco.dataFile}</dataFile>
              <outputDirectory>${jacoco.reportDir}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>integration</excludedGroups>
          <systemPropertyVariables>
            <nvim.path>${nvim.path}</nvim.path>
            <!-- How long a test waits; see testing/TestWait (the UI test fragment's shared/). -->
            <test.wait.seconds>${test.wait.seconds}</test.wait.seconds>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>integration</id>
      <properties>
        <jacoco.dataFile>${project.build.directory}/jacoco-integration.exec</jacoco.dataFile>
        <jacoco.reportDir>${project.build.directory}/site/jacoco-integration</jacoco.reportDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>integration</groups>
              <!-- Not the tests that measure time (see the timeoutReliant profile below). -->
              <excludedGroups combine.self="override">timeoutReliant</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ./mvnw test -f tests/unit/pom.xml -PtimeoutReliant -Dnvim.path=...: only the tests tagged
         "timeoutReliant", with a real Neovim. They depend on how fast the machine is (one measures
         time), so a busy machine can fail them with nothing wrong: -Pintegration and CI leave them
         out. Run them on a quiet machine after changing what they guard (see each test's comment,
         and CONTRIBUTING.md, "Tests on a loaded machine"). -->
    <profile>
      <id>timeoutReliant</id>
      <properties>
        <jacoco.dataFile>${project.build.directory}/jacoco-timeoutReliant.exec</jacoco.dataFile>
        <jacoco.reportDir>${project.build.directory}/site/jacoco-timeoutReliant</jacoco.reportDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>timeoutReliant</groups>
              <excludedGroups combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ./mvnw verify -Pall (from the top, with the UI tests too) or
         ./mvnw test -f tests/unit/pom.xml -Pall -Dnvim.path=...: every test of this module in one
         run, the unit tests, the integration tests (real Neovim, Lua tests included) and the
         timeoutReliant ones, with one coverage report for them all. -Pintegration,timeoutReliant
         would not add up: both set <groups>, and the last one wins. -->
    <profile>
      <id>all</id>
      <properties>
        <jacoco.dataFile>${project.build.directory}/jacoco-all.exec</jacoco.dataFile>
        <jacoco.reportDir>${project.build.directory}/site/jacoco-all</jacoco.reportDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

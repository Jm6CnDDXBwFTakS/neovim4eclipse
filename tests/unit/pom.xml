<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Plain jar module, part of the root reactor; also runs alone:
       mvn test -f tests/unit/pom.xml
       Library versions come from the root pom.xml (dependencyManagement). -->
  <parent>
    <groupId>io.github.jm6cnddxbwftaks.neovim4eclipse</groupId>
    <artifactId>neovim4eclipse</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>neovim4eclipse-unit-tests</artifactId>
  <packaging>jar</packaging>

  <name>Neovim for Eclipse Unit Tests</name>
  <description>
    Platform-neutral unit tests for util/ and core/ (no SWT, no Eclipse runtime).
    Sources under test come from the plug-in project; there is no second copy.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Same Java release as the plug-in (root pom.xml). -->
    <maven.compiler.release>${java.release}</maven.compiler.release>
    <!-- Coverage data and report; the integration profile writes its own pair, so a run with real
         Neovim does not overwrite the unit-test numbers. -->
    <jacoco.dataFile>${project.build.directory}/jacoco.exec</jacoco.dataFile>
    <jacoco.reportDir>${project.build.directory}/site/jacoco</jacoco.reportDir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.msgpack</groupId>
      <artifactId>msgpack-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <!-- Test helpers shared by the test modules (ExpectedLog), kept once in tests/shared. -->
          <execution>
            <id>add-shared-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../shared/src</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-plugin-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../plugins/io.github.jm6cnddxbwftaks.neovim4eclipse/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>io/github/jm6cnddxbwftaks/neovim4eclipse/util/**</include>
            <include>io/github/jm6cnddxbwftaks/neovim4eclipse/core/**</include>
          </includes>
        </configuration>
      </plugin>
      <!-- Code coverage: the JaCoCo agent records which lines the tests run; the report is
           target/site/jacoco/index.html (see CONTRIBUTING.md, "Code coverage"). prepare-agent sets
           the "argLine" property, which surefire passes to the forked test JVM. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dataFile}</destFile>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${jacoco.dataFile}</dataFile>
              <outputDirectory>${jacoco.reportDir}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>integration</excludedGroups>
          <systemPropertyVariables>
            <nvim.path>${nvim.path}</nvim.path>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>integration</id>
      <properties>
        <jacoco.dataFile>${project.build.directory}/jacoco-integration.exec</jacoco.dataFile>
        <jacoco.reportDir>${project.build.directory}/site/jacoco-integration</jacoco.reportDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <groups>integration</groups>
              <excludedGroups combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jm6cnddxbwftaks.neovim4eclipse</groupId>
    <artifactId>neovim4eclipse</artifactId>
    <version>0.2.17-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- Tycho requires artifactId == Bundle-SymbolicName. -->
  <artifactId>io.github.jm6cnddxbwftaks.neovim4eclipse.tests</artifactId>
  <packaging>eclipse-test-plugin</packaging>
  <name>Neovim for Eclipse UI Tests</name>

  <!-- Workbench tests: tycho-surefire starts a real Eclipse (the IDE workbench, with a window) with
       this fragment and the plug-in installed, and runs the JUnit 5 tests on the UI thread.
       They need a display: on a headless Linux machine run the build under xvfb-run.

       They only run with the "ui" profile: ./mvnw verify -Pui. A plain ./mvnw verify compiles them
       (so a broken test still fails the build) but starts no Eclipse, so no window opens; the UI
       tests are the only ones that open one. CI always passes -Pui. -Pui -DskipTests skips them
       again. The end-to-end tests also need nvim (they are skipped without it). Without
       -Dnvim.path they use the dedicated Neovim, as Eclipse does without -Dneovim4eclipse.nvim
       (~/.local/share/neovim4eclipse-plugin/neovim/<code>, on Windows
       %LOCALAPPDATA%\neovim4eclipse-plugin\neovim\<code>, checked against the pinned release; Get
       Neovim installs it); -Dnvim.path=/path/to/bin/nvim (the program itself, not a folder) selects
       another, passed on as -Dneovim4eclipse.nvim (the nvim-path profile below).

       The tests tagged "heavyJava" need the Java development tools (a Java editor, Format, Rename,
       Open Declaration) in the test Eclipse. They are left out of -Pui and run only with
       ./mvnw verify -PuiHeavyJava, which adds the tools (a larger download, a slower start) and
       runs only those tests. Not run in CI.

       Tests tagged "timeoutReliant" depend on how fast the machine is; -Pui leaves them out and
       ./mvnw verify -PtimeoutReliant runs only them (here and in tests/unit). Not run in CI.

       ScreenshotCaptureTest and DemoRecordingTest (tagged "screenshots") are not tests: they take
       the Marketplace screenshots and the README demo's pictures. Only ./mvnw verify -Pscreenshots
       runs them, with the Java tools for a highlighted Java editor; java
       releng/tools/marketplace/Marketplace.java pictures runs it under xvfb-run. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <configuration>
          <dependency-resolution>
            <extraRequirements>
              <!-- Everything an IDE workbench needs at test time: the IDE application, text editors,
                   resources. The plug-in itself only requires the bundles it compiles against. -->
              <requirement>
                <type>eclipse-feature</type>
                <id>org.eclipse.platform</id>
                <versionRange>0.0.0</versionRange>
              </requirement>
            </extraRequirements>
          </dependency-resolution>
        </configuration>
      </plugin>
      <!-- Code coverage of the plug-in while the workbench tests run (see CONTRIBUTING.md, "Code
           coverage"). prepare-agent puts the JaCoCo agent into tycho.testArgLine, the JVM arguments
           tycho-surefire gives the test Eclipse. Only this project's classes are instrumented:
           instrumenting all of Eclipse would slow its start-up for nothing. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <propertyName>tycho.testArgLine</propertyName>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <includes>
                <include>io.github.jm6cnddxbwftaks.*</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The UI tests run in a data folder of their own (see environmentVariables below), where no
           dedicated Neovim is installed, so a run without -Dnvim.path would start no Neovim and
           skip every end-to-end test while reporting success. Stop it at once instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>nvim-path-given</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <skip>${nvim.optional}</skip>
              <rules>
                <requireProperty>
                  <property>nvim.path</property>
                  <regex>.+</regex>
                  <regexMessage>The UI tests need -Dnvim.path=/path/to/bin/nvim (the program, e.g. a pinned release from java releng/tools/ci/LikeCi.java): they use a data folder of their own, without the dedicated Neovim. See CONTRIBUTING.md, "Your Neovim config and the UI tests".</regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The report. jacoco:report only knows its own module's classes, and the classes under test
           here are the plug-in's (this module only holds the tests), so the JaCoCo Ant task is used:
           it takes the plug-in's class and source folders explicitly. The report is
           target/site/jacoco/index.html. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${ui.skip}</skip>
              <target>
                <taskdef uri="antlib:org.jacoco.ant" resource="org/jacoco/ant/antlib.xml"
                         classpathref="maven.plugin.classpath"/>
                <!-- The agent writes jacoco.exec when the test Eclipse exits. If it did not (the agent
                     was not on its command line, or the process ended without running shutdown hooks),
                     the report is still made, empty, and the build goes on: missing coverage numbers
                     must not fail a build whose tests passed. -->
                <condition property="coverage.missing">
                  <not>
                    <available file="${project.build.directory}/jacoco.exec"/>
                  </not>
                </condition>
                <echo level="warning" message="No coverage data (target/jacoco.exec) from the UI tests: the report will be empty." if:set="coverage.missing" xmlns:if="ant:if"/>
                <jacoco:report xmlns:jacoco="antlib:org.jacoco.ant">
                  <executiondata>
                    <fileset dir="${project.build.directory}" includes="jacoco.exec"/>
                  </executiondata>
                  <structure name="Neovim for Eclipse plug-in (UI tests)">
                    <classfiles>
                      <fileset dir="${project.basedir}/../../plugins/io.github.jm6cnddxbwftaks.neovim4eclipse/target/classes"/>
                    </classfiles>
                    <sourcefiles encoding="UTF-8">
                      <fileset dir="${project.basedir}/../../plugins/io.github.jm6cnddxbwftaks.neovim4eclipse/src"/>
                    </sourcefiles>
                  </structure>
                  <html destdir="${project.build.directory}/site/jacoco"/>
                  <csv destfile="${project.build.directory}/site/jacoco/jacoco.csv"/>
                  <xml destfile="${project.build.directory}/site/jacoco/jacoco.xml"/>
                </jacoco:report>
              </target>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.ant</artifactId>
            <version>${jacoco.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Without -Pui: no test Eclipse is started at all (see the comment at the top). This is
               skipTests, not skip: tycho-surefire 5.0.4 ignores a configured <skip>. -->
          <skipTests>${ui.skip}</skipTests>
          <useUIHarness>true</useUIHarness>
          <useUIThread>true</useUIThread>
          <!-- No <argLine> here on purpose: tycho-surefire's default is ${tycho.testArgLine}, read
               when the tests start. By then jacoco:prepare-agent has put its agent there, in front of
               what the macOS profile below puts there (-XstartOnFirstThread). An <argLine> written
               here, or a tycho.testArgLine declared in <properties>, would be filled in when the POM
               is read, before the agent is known, and the agent would be lost. -->
          <application>org.eclipse.ui.ide.workbench</application>
          <!-- Arguments for the test Eclipse itself (not the JVM): default preferences from
               test-customization.ini, which turns the welcome dialog off (see that file). -->
          <appArgLine>-pluginCustomization ${project.basedir}/test-customization.ini</appArgLine>
          <systemProperties>
            <nvim.path>${nvim.path}</nvim.path>
            <!-- How long a test waits (EndToEndTestBase.TIMEOUT_MS); see testing/TestWait. -->
            <test.wait.seconds>${test.wait.seconds}</test.wait.seconds>
            <!-- The folder no test may write outside of (testing/TestIsolation checks the data home
                 against it, and DedicatedNeovim refuses to change a folder elsewhere). -->
            <test.isolated.root>${tests.isolated.root}</test.isolated.root>
            <!-- Where ScreenshotCaptureTest writes its PNG files. -->
            <screenshots.dir>${project.build.directory}/screenshots</screenshots.dir>
          </systemProperties>
          <!-- The test Eclipse runs in folders of its own, so a run on a developer's machine sees what
               a CI runner sees, and changes nothing outside target/ (CONTRIBUTING.md, "Your Neovim
               config and the UI tests"):
               - NVIM_APPNAME: Neovim looks for its config under another name, where there is none,
                 so no init.lua, plug-ins, saved registers or marks of whoever runs the build.
               - XDG_CONFIG_HOME, XDG_STATE_HOME, XDG_CACHE_HOME: what Neovim writes (and any config
                 it would look for) goes under target/.
               - XDG_DATA_HOME: the plug-in's own folder too (util/PluginFolders follows Neovim's data
                 home on every system, Windows included), so the dedicated Neovim the tests see is the
                 one a test put there (prefs/DedicatedNeovim), never the developer's: a runner has none,
                 and a test that read the real folder passed on one and failed on the other. The plug-in
                 also cleans that folder up at every Neovim start (NeovimInstaller), which must not
                 touch the real one. Hence -Dnvim.path is required (the enforcer rule below).
               - LC_MESSAGES=C: Neovim's messages in English, which tests compare, whatever language
                 the machine uses.
               The whole test Eclipse sees these variables, not only Neovim: on Linux, GTK and font
               caches land under target/ too, which costs a little start-up time and nothing else. -->
          <environmentVariables>
            <NVIM_APPNAME>neovim4eclipse-plugin/tests</NVIM_APPNAME>
            <XDG_CONFIG_HOME>${project.build.directory}/neovim-home/config</XDG_CONFIG_HOME>
            <XDG_STATE_HOME>${project.build.directory}/neovim-home/state</XDG_STATE_HOME>
            <XDG_CACHE_HOME>${project.build.directory}/neovim-home/cache</XDG_CACHE_HOME>
            <XDG_DATA_HOME>${tests.isolated.root}/neovim-home/data</XDG_DATA_HOME>
            <LC_MESSAGES>C</LC_MESSAGES>
          </environmentVariables>
          <!-- Which tests run, by JUnit tag: all but the "heavyJava" ones, unless the uiHeavyJava
               profile swaps the two properties (see the comment at the top). -->
          <groups>${ui.groups}</groups>
          <excludedGroups>${ui.excludedGroups}</excludedGroups>
          <!-- Each run gets a fresh workspace under target/. -->
          <deleteOsgiDataDirectory>true</deleteOsgiDataDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!-- Empty: the test Eclipse runs the dedicated Neovim, as Eclipse does without the startup
         option -Dneovim4eclipse.nvim (see the nvim-path profile). -->
    <nvim.path></nvim.path>
    <!-- Whether the run may go without -Dnvim.path: yes, unless a profile that starts Neovim is on
         (ui, uiHeavyJava, timeoutReliant, screenshots, gallery, all), which sets it to ${skipTests}. -->
    <nvim.optional>true</nvim.optional>
    <!-- -DskipTests sets it to true; the ui profile passes it on to ui.skip. -->
    <skipTests>false</skipTests>
    <!-- Whether the UI tests and their coverage report are skipped: yes, unless the ui profile is on. -->
    <ui.skip>true</ui.skip>
    <!-- The JUnit tags run and left out; see the uiHeavyJava profile. Empty: no filter. -->
    <ui.groups></ui.groups>
    <ui.excludedGroups>gallery,heavyJava,screenshots,timeoutReliant</ui.excludedGroups>
    <!-- The folder the test Eclipse keeps the plug-in's data in (XDG_DATA_HOME, under neovim-home/data)
         and the only one the tests may change (test.isolated.root, prefs/DedicatedNeovim): target/.
         The gallery and screenshots profiles set it to pictures.home instead. -->
    <tests.isolated.root>${project.build.directory}</tests.isolated.root>
    <!-- Where the pictures' runs (-Pgallery, -Pscreenshots) keep the plug-in's data and their own
         files: outside the home folder, where target/ usually is, so no picture shows the account
         name in a path (gallery/PicturesFolder). /tmp on Linux and macOS; on Windows the
         pictures-home-windows profile below picks C:\Users\Public, since the temp folder there is
         under the account's own folder. -Dpictures.home=... sets another. -->
    <pictures.home>/tmp/neovim4eclipse-pictures</pictures.home>
  </properties>

  <profiles>
    <!-- -Dnvim.path=/path/to/nvim given: the test Eclipse starts with the plug-in's startup option
         -Dneovim4eclipse.nvim set to it (util/NeovimOption), as a user's Eclipse started with
         "-vmargs -Dneovim4eclipse.nvim=..." does. A system property, read before the plug-in starts,
         so no test window sees the dedicated Neovim first (with none installed, Get Neovim then
         opened by itself at the test Eclipse's start). Only when nvim.path is given on the command
         line, and not empty: Maven activates a profile by a property only from -D, not from
         <properties> above, and only for a non-empty value (an empty -Dnvim.path= leaves it off,
         checked with help:active-profiles). An empty value would reach the test Eclipse as the text
         "null". -->
    <profile>
      <id>nvim-path</id>
      <activation>
        <property>
          <name>nvim.path</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-surefire-plugin</artifactId>
            <configuration>
              <systemProperties combine.children="append">
                <neovim4eclipse.nvim>${nvim.path}</neovim4eclipse.nvim>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- On Windows, pictures.home is C:\Users\Public\neovim4eclipse-pictures: a folder every
         account may write and whose path holds no account name (the temp folder,
         C:\Users\<account>\AppData\Local\Temp, does). gallery/PicturesFolder refuses it if another
         account made it. -->
    <profile>
      <id>pictures-home-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <pictures.home>C:\Users\Public\neovim4eclipse-pictures</pictures.home>
      </properties>
    </profile>
    <!-- ./mvnw verify -Pui: start the test Eclipse and run the UI tests (unless -DskipTests). -->
    <profile>
      <id>ui</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <nvim.optional>${skipTests}</nvim.optional>
      </properties>
    </profile>
    <!-- ./mvnw verify -PuiHeavyJava: the test Eclipse also gets the Java development tools (the
         org.eclipse.jdt feature: Java editor, formatter, refactorings, and the JRE detection a Java
         project needs), and runs only the tests tagged "heavyJava" (JavaEditorEndToEndTest). Slow to
         start and a large first download, so it is off in -Pui and in CI; run it after changing
         how Eclipse's own edits reach Neovim, or the gd/K key lookup. -->
    <profile>
      <id>uiHeavyJava</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <nvim.optional>${skipTests}</nvim.optional>
        <ui.groups>heavyJava</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement>
                    <type>eclipse-feature</type>
                    <id>org.eclipse.jdt</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ./mvnw verify -PtimeoutReliant: runs only the UI tests tagged "timeoutReliant", which depend on
         how fast the machine is, so -Pui and CI leave them out (as tests/unit does for its
         integration tests with that tag). None is tagged yet; failIfNoTests keeps the profile usable
         until one is. See CONTRIBUTING.md, "Tests on a loaded machine". -->
    <profile>
      <id>timeoutReliant</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <nvim.optional>${skipTests}</nvim.optional>
        <ui.groups>timeoutReliant</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
        <failIfNoTests>false</failIfNoTests>
      </properties>
    </profile>
    <!-- ./mvnw verify -Pscreenshots: runs only ScreenshotCaptureTest and DemoRecordingTest, with the
         Java development tools (the same extra requirement as uiHeavyJava), and writes
         target/screenshots/*.png and target/screenshots/demo/ (the demo's pictures). -->
    <profile>
      <id>screenshots</id>
      <properties>
        <!-- Data and files outside the home folder: see pictures.home above. -->
        <tests.isolated.root>${pictures.home}</tests.isolated.root>
        <ui.skip>${skipTests}</ui.skip>
        <nvim.optional>${skipTests}</nvim.optional>
        <ui.groups>screenshots</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement>
                    <type>eclipse-feature</type>
                    <id>org.eclipse.jdt</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ./mvnw verify -Pgallery: runs only the tests tagged "gallery", which draw what the manual
         checks look at into target/gallery/: ChecksGalleryTest the dialogs and preference-page notes
         (index.html groups them by topic and says what to look for in each), SearchGalleryTest the
         search highlights (search.html). Then a second test Eclipse, started with Eclipse's dark
         theme (-cssTheme, as a user's Eclipse starts after choosing Dark), takes SearchGalleryTest's
         pictures again ("galleryDark"), so search.html shows each in both themes. With the Java
         development tools (the Java editor's syntax colors under the highlights) and
         org.eclipse.ui.themes (the dark theme). CONTRIBUTING.md, under "Build and test". -->
    <profile>
      <id>gallery</id>
      <properties>
        <!-- Data and files outside the home folder: see pictures.home above. -->
        <tests.isolated.root>${pictures.home}</tests.isolated.root>
        <ui.skip>${skipTests}</ui.skip>
        <!-- SearchGalleryTest starts Neovim: -Dnvim.path is required, as for -Pui. -->
        <nvim.optional>${skipTests}</nvim.optional>
        <ui.groups>gallery</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement>
                    <type>eclipse-feature</type>
                    <id>org.eclipse.jdt</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                  <requirement>
                    <type>eclipse-plugin</type>
                    <id>org.eclipse.ui.themes</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>tycho-surefire-plugin</artifactId>
            <version>${tycho.version}</version>
            <executions>
              <execution>
                <id>gallery-dark</id>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <appArgLine>-pluginCustomization ${project.basedir}/test-customization.ini -cssTheme org.eclipse.e4.ui.css.theme.e4_dark</appArgLine>
                  <groups>galleryDark</groups>
                  <excludedGroups></excludedGroups>
                  <systemProperties combine.children="append">
                    <gallery.theme>dark</gallery.theme>
                  </systemProperties>
                  <reportsDirectory>${project.build.directory}/surefire-reports-dark</reportsDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ./mvnw verify -Pall: every test of every group in one run, here and in tests/unit (there
         also the integration tests): the -Pui tests, heavyJava (so with the Java development tools,
         as uiHeavyJava) and timeoutReliant. Only "screenshots" stays out: it is not a test, and it
         rewrites the Marketplace images; nor does "gallery", which only draws pictures. Combining the other profiles (-Pui,uiHeavyJava) does not
         add them up: each sets ui.groups, and the last one wins. Slow; for a release or a big
         change, not CI. See CONTRIBUTING.md, "Running every test" (a paragraph under the build commands). -->
    <profile>
      <id>all</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <nvim.optional>${skipTests}</nvim.optional>
        <ui.groups></ui.groups>
        <ui.excludedGroups>gallery,screenshots</ui.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement>
                    <type>eclipse-feature</type>
                    <id>org.eclipse.jdt</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- macOS: Cocoa lets only the process's first thread create the SWT Display, and Java runs main()
         on another thread unless -XstartOnFirstThread is given. Without it the test Eclipse stops at
         start-up with "SWTException: Invalid thread access" (exit code 13). An installed Eclipse gets
         the flag from its eclipse.ini; here it has to be passed by hand. Tycho does not add it. It
         goes into tycho.testArgLine, which jacoco:prepare-agent extends with its agent. -->
    <profile>
      <id>macos-first-thread</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <tycho.testArgLine>-XstartOnFirstThread</tycho.testArgLine>
      </properties>
    </profile>
  </profiles>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jm6cnddxbwftaks.neovim4eclipse</groupId>
    <artifactId>neovim4eclipse</artifactId>
    <version>0.1.7-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- Tycho requires artifactId == Bundle-SymbolicName. -->
  <artifactId>io.github.jm6cnddxbwftaks.neovim4eclipse.tests</artifactId>
  <packaging>eclipse-test-plugin</packaging>
  <name>Neovim for Eclipse UI Tests</name>

  <!-- Workbench tests: tycho-surefire starts a real Eclipse (the IDE workbench, with a window) with
       this fragment and the plug-in installed, and runs the JUnit 5 tests on the UI thread.
       They need a display: on a headless Linux machine run the build under xvfb-run.

       They only run with the "ui" profile: ./mvnw verify -Pui. A plain ./mvnw verify compiles them
       (so a broken test still fails the build) but starts no Eclipse, so no window opens; the UI
       tests are the only ones that open one. CI always passes -Pui. -Pui -DskipTests skips them
       again. The end-to-end tests also need nvim (they are skipped without it). Without
       -Dnvim.path they search as a blank preference does (~/.local/share/neovim4eclipse-plugin/neovim first, then PATH);
       -Dnvim.path=/path/to/neovim (a folder or the program) selects one.

       The tests tagged "heavyJava" need the Java development tools (a Java editor, Format, Rename,
       Open Declaration) in the test Eclipse. They are left out of -Pui and run only with
       ./mvnw verify -PuiHeavyJava, which adds the tools (a larger download, a slower start) and
       runs only those tests. Not run in CI.

       Tests tagged "timeoutReliant" depend on how fast the machine is; -Pui leaves them out and
       ./mvnw verify -PtimeoutReliant runs only them (here and in tests/unit). Not run in CI.

       ScreenshotCaptureTest (tagged "screenshots") is not a test: it takes the Marketplace and README
       screenshots. Only ./mvnw verify -Pscreenshots runs it, with the Java tools for a highlighted
       Java editor; see that class for the xvfb-run command. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <configuration>
          <dependency-resolution>
            <extraRequirements>
              <!-- Everything an IDE workbench needs at test time: the IDE application, text editors,
                   resources. The plug-in itself only requires the bundles it compiles against. -->
              <requirement>
                <type>eclipse-feature</type>
                <id>org.eclipse.platform</id>
                <versionRange>0.0.0</versionRange>
              </requirement>
            </extraRequirements>
          </dependency-resolution>
        </configuration>
      </plugin>
      <!-- Code coverage of the plug-in while the workbench tests run (see CONTRIBUTING.md, "Code
           coverage"). prepare-agent puts the JaCoCo agent into tycho.testArgLine, the JVM arguments
           tycho-surefire gives the test Eclipse. Only this project's classes are instrumented:
           instrumenting all of Eclipse would slow its start-up for nothing. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <propertyName>tycho.testArgLine</propertyName>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <includes>
                <include>io.github.jm6cnddxbwftaks.*</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The report. jacoco:report only knows its own module's classes, and the classes under test
           here are the plug-in's (this module only holds the tests), so the JaCoCo Ant task is used:
           it takes the plug-in's class and source folders explicitly. The report is
           target/site/jacoco/index.html. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${ui.skip}</skip>
              <target>
                <taskdef uri="antlib:org.jacoco.ant" resource="org/jacoco/ant/antlib.xml"
                         classpathref="maven.plugin.classpath"/>
                <!-- The agent writes jacoco.exec when the test Eclipse exits. If it did not (the agent
                     was not on its command line, or the process ended without running shutdown hooks),
                     the report is still made, empty, and the build goes on: missing coverage numbers
                     must not fail a build whose tests passed. -->
                <condition property="coverage.missing">
                  <not>
                    <available file="${project.build.directory}/jacoco.exec"/>
                  </not>
                </condition>
                <echo level="warning" message="No coverage data (target/jacoco.exec) from the UI tests: the report will be empty." if:set="coverage.missing" xmlns:if="ant:if"/>
                <jacoco:report xmlns:jacoco="antlib:org.jacoco.ant">
                  <executiondata>
                    <fileset dir="${project.build.directory}" includes="jacoco.exec"/>
                  </executiondata>
                  <structure name="Neovim for Eclipse plug-in (UI tests)">
                    <classfiles>
                      <fileset dir="${project.basedir}/../../plugins/io.github.jm6cnddxbwftaks.neovim4eclipse/target/classes"/>
                    </classfiles>
                    <sourcefiles encoding="UTF-8">
                      <fileset dir="${project.basedir}/../../plugins/io.github.jm6cnddxbwftaks.neovim4eclipse/src"/>
                    </sourcefiles>
                  </structure>
                  <html destdir="${project.build.directory}/site/jacoco"/>
                  <csv destfile="${project.build.directory}/site/jacoco/jacoco.csv"/>
                  <xml destfile="${project.build.directory}/site/jacoco/jacoco.xml"/>
                </jacoco:report>
              </target>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.ant</artifactId>
            <version>${jacoco.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Without -Pui: no test Eclipse is started at all (see the comment at the top). This is
               skipTests, not skip: tycho-surefire 5.0.4 ignores a configured <skip>. -->
          <skipTests>${ui.skip}</skipTests>
          <useUIHarness>true</useUIHarness>
          <useUIThread>true</useUIThread>
          <!-- No <argLine> here on purpose: tycho-surefire's default is ${tycho.testArgLine}, read
               when the tests start. By then jacoco:prepare-agent has put its agent there, in front of
               what the macOS profile below puts there (-XstartOnFirstThread). An <argLine> written
               here, or a tycho.testArgLine declared in <properties>, would be filled in when the POM
               is read, before the agent is known, and the agent would be lost. -->
          <application>org.eclipse.ui.ide.workbench</application>
          <!-- Arguments for the test Eclipse itself (not the JVM): default preferences from
               test-customization.ini, which turns the welcome dialog off (see that file). -->
          <appArgLine>-pluginCustomization ${project.basedir}/test-customization.ini</appArgLine>
          <systemProperties>
            <nvim.path>${nvim.path}</nvim.path>
            <!-- How long a test waits (EndToEndTestBase.TIMEOUT_MS); see testing/TestWait. -->
            <test.wait.seconds>${test.wait.seconds}</test.wait.seconds>
            <!-- Where ScreenshotCaptureTest writes its PNG files. -->
            <screenshots.dir>${project.build.directory}/screenshots</screenshots.dir>
          </systemProperties>
          <!-- Which tests run, by JUnit tag: all but the "heavyJava" ones, unless the uiHeavyJava
               profile swaps the two properties (see the comment at the top). -->
          <groups>${ui.groups}</groups>
          <excludedGroups>${ui.excludedGroups}</excludedGroups>
          <!-- Each run gets a fresh workspace under target/. -->
          <deleteOsgiDataDirectory>true</deleteOsgiDataDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!-- Empty: use the plug-in's own default (nvim on PATH or in the usual install folders). -->
    <nvim.path></nvim.path>
    <!-- -DskipTests sets it to true; the ui profile passes it on to ui.skip. -->
    <skipTests>false</skipTests>
    <!-- Whether the UI tests and their coverage report are skipped: yes, unless the ui profile is on. -->
    <ui.skip>true</ui.skip>
    <!-- The JUnit tags run and left out; see the uiHeavyJava profile. Empty: no filter. -->
    <ui.groups></ui.groups>
    <ui.excludedGroups>heavyJava,screenshots,timeoutReliant</ui.excludedGroups>
  </properties>

  <profiles>
    <!-- ./mvnw verify -Pui: start the test Eclipse and run the UI tests (unless -DskipTests). -->
    <profile>
      <id>ui</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
      </properties>
    </profile>
    <!-- ./mvnw verify -PuiHeavyJava: the test Eclipse also gets the Java development tools (the
         org.eclipse.jdt feature: Java editor, formatter, refactorings, and the JRE detection a Java
         project needs), and runs only the tests tagged "heavyJava" (JavaEditorEndToEndTest). Slow to
         start and a large first download, so it is off in -Pui and in CI; run it after changing
         how Eclipse's own edits reach Neovim, or the gd/K key lookup. -->
    <profile>
      <id>uiHeavyJava</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <ui.groups>heavyJava</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement>
                    <type>eclipse-feature</type>
                    <id>org.eclipse.jdt</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ./mvnw verify -PtimeoutReliant: runs only the UI tests tagged "timeoutReliant", which depend on
         how fast the machine is, so -Pui and CI leave them out (as tests/unit does for its
         integration tests with that tag). None is tagged yet; failIfNoTests keeps the profile usable
         until one is. See CONTRIBUTING.md, "Tests on a loaded machine". -->
    <profile>
      <id>timeoutReliant</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <ui.groups>timeoutReliant</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
        <failIfNoTests>false</failIfNoTests>
      </properties>
    </profile>
    <!-- ./mvnw verify -Pscreenshots: runs only ScreenshotCaptureTest, with the Java development tools
         (the same extra requirement as uiHeavyJava), and writes target/screenshots/*.png. -->
    <profile>
      <id>screenshots</id>
      <properties>
        <ui.skip>${skipTests}</ui.skip>
        <ui.groups>screenshots</ui.groups>
        <ui.excludedGroups></ui.excludedGroups>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho</groupId>
            <artifactId>target-platform-configuration</artifactId>
            <configuration>
              <dependency-resolution>
                <extraRequirements combine.children="append">
                  <requirement>
                    <type>eclipse-feature</type>
                    <id>org.eclipse.jdt</id>
                    <versionRange>0.0.0</versionRange>
                  </requirement>
                </extraRequirements>
              </dependency-resolution>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- macOS: Cocoa lets only the process's first thread create the SWT Display, and Java runs main()
         on another thread unless -XstartOnFirstThread is given. Without it the test Eclipse stops at
         start-up with "SWTException: Invalid thread access" (exit code 13). An installed Eclipse gets
         the flag from its eclipse.ini; here it has to be passed by hand. Tycho does not add it. It
         goes into tycho.testArgLine, which jacoco:prepare-agent extends with its agent. -->
    <profile>
      <id>macos-first-thread</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <tycho.testArgLine>-XstartOnFirstThread</tycho.testArgLine>
      </properties>
    </profile>
  </profiles>
</project>

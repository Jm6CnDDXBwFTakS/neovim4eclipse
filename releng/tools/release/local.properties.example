# Copy to local.properties (ignored by git) to override settings.properties on this machine only.

# LikeCi's arguments for the check step; empty runs only what CI runs (-Pui, then the integration tests).
#tests=

# The commits' last paragraph (commit.trailer), the update site (site.url) and the signing key
# (signing.key) are settings of every tool: set them in releng/tools/common/local.properties, not here.

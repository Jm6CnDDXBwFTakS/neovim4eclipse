<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jm6cnddxbwftaks.neovim4eclipse</groupId>
    <artifactId>neovim4eclipse</artifactId>
    <version>0.1.3-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>io.github.jm6cnddxbwftaks.neovim4eclipse.updatesite</artifactId>
  <packaging>eclipse-repository</packaging>

  <name>Neovim for Eclipse Update Site</name>

  <build>
    <!-- Name of the installable archive: target/neovim4eclipse-<version>.zip -->
    <finalName>neovim4eclipse-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-repository-plugin</artifactId>
        <configuration>
          <includeAllDependencies>false</includeAllDependencies>
          <compress>true</compress>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

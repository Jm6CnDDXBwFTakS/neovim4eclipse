<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jm6cnddxbwftaks.neovim4eclipse</groupId>
    <artifactId>neovim4eclipse</artifactId>
    <version>0.1.3-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>io.github.jm6cnddxbwftaks.neovim4eclipse</artifactId>
  <packaging>eclipse-plugin</packaging>

  <name>Neovim for Eclipse Plug-in</name>

  <build>
    <plugins>
      <!-- Embedded third-party jars. Versions come from the root pom.xml's dependencyManagement;
           file names carry no version so MANIFEST.MF's Bundle-ClassPath never changes on upgrade.
           lib/ is generated (git-ignored). BundleClassPathConsistencyTest keeps this list, the
           manifest and the root versions in step. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <?m2e execute onConfiguration?>
            <id>embed-libraries</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}/lib</outputDirectory>
              <stripVersion>true</stripVersion>
              <!-- Copy a jar only when the repository's copy is newer (a version upgrade), never an
                   unchanged one: on Windows Eclipse keeps lib/*.jar open, and overwriting an open
                   file fails ("being used by another process") on every m2e build. -->
              <overWriteReleases>false</overWriteReleases>
              <overWriteIfNewer>true</overWriteIfNewer>
              <artifactItems>
                <artifactItem>
                  <groupId>org.msgpack</groupId>
                  <artifactId>msgpack-core</artifactId>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>lib</directory>
              <includes>
                <include>*.jar</include>
              </includes>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

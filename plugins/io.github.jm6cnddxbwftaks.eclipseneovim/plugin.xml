   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <!-- Attach and Detach have no menu entries (attaching is automatic); their commands remain,
              reachable through their key bindings and Quick Access (Ctrl+3). -->
         <menu id="io.github.jm6cnddxbwftaks.eclipseneovim.menu" label="Neovim" mnemonic="N">
            <!-- The "Show Neovim menu in the menu bar" preference (NeovimPropertyTester). -->
            <visibleWhen checkEnabled="false">
               <test
                     property="io.github.jm6cnddxbwftaks.eclipseneovim.showMenu"
                     value="true">
               </test>
            </visibleWhen>
            <command
                  commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.toggleMode"
                  label="Toggle Neovim / Eclipse Mode"
                  style="push">
            </command>
            <separator name="prefs" visible="true"/>
            <command
                  commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.openPreferences"
                  label="Preferences..."
                  style="push">
            </command>
         </menu>
      </menuContribution>
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="io.github.jm6cnddxbwftaks.eclipseneovim.toolbar">
            <command
                  commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.toggleMode"
                  id="io.github.jm6cnddxbwftaks.eclipseneovim.toolbar.toggleMode"
                  label="NVIM"
                  tooltip="Toggle Neovim / Eclipse editing mode"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <test
                        property="io.github.jm6cnddxbwftaks.eclipseneovim.showToolbar"
                        value="true">
                  </test>
               </visibleWhen>
            </command>
         </toolbar>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.attach"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+N">
      </key>
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.toggleMode"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+M">
      </key>
      <!-- Vim Ctrl keys: one binding per letter, each in its own context, so that the editor can
           switch letters on and off by activating contexts (see VimCtrlKeys and the Ctrl Keys
           preference page). One parameterless command per key. Eclipse's platform-neutral
           modifiers: M1 is Ctrl on Windows/Linux; on macOS M1 is Command (which stays Paste etc.)
           and the physical Control key is M4. Generated: keep in step with VimCtrlKeys.LETTERS
           (PluginXmlConsistencyTest checks it). -->
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.ctrl.a"
            contextId="io.github.jm6cnddxbwftaks.eclipseneovim.context.ctrl.a"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            platform="win32"
            sequence="M1+A">
      </key>
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.ctrl.a"
            contextId="io.github.jm6cnddxbwftaks.eclipseneovim.context.ctrl.a"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            platform="gtk"
            sequence="M1+A">
      </key>
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.ctrl.a"
            contextId="io.github.jm6cnddxbwftaks.eclipseneovim.context.ctrl.a"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            platform="cocoa"
            sequence="M4+A">
      </key>
      <key
            commandId="io.github.jm6cnddxbwftaks.eclipseneovim.commands.ctrl.b"
            contextId="io.github.jm6cnddxbwftaks.eclipseneovim.context.ctrl.b"
